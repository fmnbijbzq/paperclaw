DATABASE_URL=sqlite:///data/papers.db
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
LOG_INCLUDE_LOCATION=false
LOG_FILE=
TIMEZONE=Asia/Shanghai
MAX_NOTIFY_ITEMS=10

# API key for write endpoints (POST/PATCH/DELETE).
# When empty, the server FAIL-CLOSES — write requests get HTTP 503.
# Set to a strong random string before exposing the API beyond localhost.
API_KEY=

# Comma-separated list of origins allowed by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Hard timeout (seconds) for a single dashboard-triggered pipeline task.
# The worker checks the deadline between stages — once exceeded the task
# is finalized as failed (errorMessage="timeout after Ns"). This prevents
# a stuck stage from blocking the single-worker queue. Default 30 minutes.
PIPELINE_TASK_TIMEOUT_SECONDS=1800
